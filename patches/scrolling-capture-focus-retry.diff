+                case ScrollMethod.ScrollMessage:
+                    for (int i = 0; i < Options.ScrollAmount; i++)
+                    {
+                        NativeMethods.SendMessage(selectedWindow.Handle, (int)WindowsMessages.VSCROLL, (int)ScrollBarCommands.SB_LINEDOWN, 0);
+                    }
+                    break;
+            }
+        }
